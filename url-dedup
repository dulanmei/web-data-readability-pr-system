# -*- coding: utf-8 -*-

import pandas as pd

file_path = "Readability_Results.xlsx"

df = pd.read_excel(file_path)

print("=" * 60)
print("Before deduplication")
print("=" * 60)
print(f"Total rows: {len(df)}")

columns_to_check = [
    "Characters",
    "Words",
    "Sentences",
    "Average Sentence Length",
    "Average Word Length",
    "Syllables",
    "Average Syllables per Word",
    "Polysyllabic Words",
    "Complex Word Ratio",
    "Flesch Reading Ease",
    "Flesch-Kincaid Grade",
    "Gunning Fog",
    "SMOG Index",
    "Coleman-Liau Index",
    "Automated Readability Index",
    "Dale-Chall Score"
]

df_unique = df.drop_duplicates(
    subset=columns_to_check,
    keep="first"
)

print()
print("=" * 60)
print("After deduplication")
print("=" * 60)
print(f"Remaining rows: {len(df_unique)}")
print(f"Removed rows: {len(df) - len(df_unique)}")

output_file = "Readability_Results_Deduplicated.xlsx"

df_unique.to_excel(output_file, index=False)

print()
print(f"Saved to: {output_file}")
